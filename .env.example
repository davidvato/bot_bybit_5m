# =============================================================================
# BYBIT API CREDENTIALS - CONFIGURACIÓN DE CLAVES
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Reemplaza los valores con tus credenciales reales de Bybit
# 3. NUNCA subas el archivo ".env" a un repositorio público (ya está en .gitignore)
# 4. Para obtener tus API Keys: Bybit > Account > API Management > Create New Key
#    Permisos necesarios: "Contract - Read & Write" y "Unified Trading"
# =============================================================================

# --- CREDENCIALES DE API ---
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# --- ENTORNO (true = Testnet, false = Mainnet REAL) ---
# IMPORTANTE: Usar TESTNET=true para pruebas antes de operar con dinero real
BYBIT_TESTNET=true

# --- CONFIGURACIÓN GENERAL DEL BOT ---
# Par de trading (formato Bybit Futures)
TRADING_SYMBOL=BTCUSDT

# Temporalidad de las velas en minutos
# 5m  = Scalping (más ruido, más señales falsas)
# 15m = Recomendado para este sistema de 4 estrategias (mejor señal/ruido)
# 1h  = Conservador (pocas señales, más calidad)
TIMEFRAME=15

# Categoría del mercado: "linear" (USDT Perpetual), "inverse" (Coin-M)
MARKET_CATEGORY=linear

# --- GESTIÓN DE RIESGO ---
# Porcentaje del balance de la cuenta a arriesgar por operación (ej. 0.02 = 2%)
RISK_PER_TRADE=0.02

# Apalancamiento fijo (ej. 5 = 5x)
LEVERAGE=5

# Multiplicador ATR para el Stop Loss (ej. 2.0 significa SL = 2.0 * ATR)
# 2.0 es adecuado para 15m: da espacio suficiente sin sacrificar demasiado riesgo.
ATR_SL_MULTIPLIER=2.0

# Ratio Riesgo/Beneficio para Take Profit (ej. 2.0 significa TP = 2 * distancia_SL)
RISK_REWARD_RATIO=2.0

# Perdida maxima diaria en USDT. Si se alcanza, el bot deja de operar ese dia.
# 0.0 = sin limite (no recomendado para produccion real)
# Ejemplo: 50.0 = el bot detiene nuevas entradas cuando acumula -50 USDT en el dia
MAX_DAILY_LOSS=0.0

# --- FILTROS DE MERCADO ---
# ADX minimo para operar. Valores por debajo indican mercado lateral.
# 20.0 = filtro moderado. 25.0 = filtro estricto (menos operaciones, mas calidad)
ADX_MIN_THRESHOLD=20.0

# --- CONFIGURACIÓN DE LOGGING ---
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/bot_trading.log

# =============================================================================
# NOTIFICACIONES TELEGRAM (OPCIONAL)
# =============================================================================
# Si se configuran, el bot enviará alertas al chat indicado.
# Dejar vacío para desactivar las notificaciones.
#
# Cómo obtener el token:
#   1. Habla con @BotFather en Telegram
#   2. Crea un nuevo bot con /newbot
#   3. Copia el token que te da
#
# Cómo obtener tu Chat ID:
#   1. Habla con @userinfobot en Telegram
#   2. Te dará tu ID numérico (ej: 123456789)
#   O bien: usa @getmyid_bot
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
